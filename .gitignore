# ---- dependencies ----
node_modules/
.pnpm-store/

# ---- build output ----
dist/
.astro/
.output/
.wrangler/

# NOTE: public/wasm/*.wasm and public/traces/*.json ARE committed on purpose.
# They are build artifacts checked in deliberately (plan §6). Do not ignore them.

# ---- secrets ----
.env
.env.*
!.env.example
.dev.vars
*.pem
*.key

# ---- logs ----
*.log
npm-debug.log*
pnpm-debug.log*

# ---- assistant state (D33) ----
# .claude/skills/ and CLAUDE.md ARE tracked on purpose — they are symlinks
# into docs/practices/, and tracking them is what makes a fresh clone work.
.claude/settings.local.json
.claude/*.local.json

# ---- editors ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# ---- macOS ----
.DS_Store
._*
.Spotlight-V100
.Trashes

# ---- personal data (D31) ----
# Only the web résumé variant belongs here, and it carries no phone number.
resume_general_swe_with_shell.tex
resume_systems_infra.tex
resume_product_management.tex
resume_research.tex
*.aux
*.log
*.synctex.gz

# ---- guard rail (D21): coursework must never reach this repo ----
# These patterns are here so an accidental copy is silently ignored rather than
# committed. Git history is permanent; a wrong commit here cannot be undone by a
# revert. If one of these ever matches something you actually wanted, you are in
# the wrong directory.
cs252/
shell-private/
private-shell/
shell/
*.y
*.l
*.tar.gz
core
core.*
