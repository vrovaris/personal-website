---
import Notebook from "../layouts/Notebook.astro";
import Scribble from "../components/notebook/Scribble.astro";
import Polaroid from "../components/notebook/Polaroid.astro";
import LinkIcons from "../components/notebook/LinkIcons.astro";
import { pages } from "../data/pages";
import { profile } from "../data/profile";

const { orgs } = profile;

// tab n = pages 2n-1 and 2n
const blurbs: Record<string, { what: string; note?: string }> = {
    "/me/": { what: "a bit more on how I ended up here" },
    "/built/": { what: "a sandbox, a scheduler, a shell" },
    "/shelf/": { what: "books, movies, music" },
    "/work/": {
        what: "the tidy version",
        note: "recruiters, this one’s for you!",
    },
};
const contents = pages
    .slice(1)
    .map((p, i) => ({ ...p, ...blurbs[p.href], page: 2 * (i + 1) + 1 }));
---

<Notebook
    title="Vitor Rovaris"
    description="Vitor Rovaris: CS at Purdue, from Joinville, Brazil. Things I built, where I worked, and what I read, watch, and listen to."
    subject="hi"
>
    <h1>howdy! I’m Vitor.</h1>

    <p>
        I’m a <mark>computer science major</mark> at{" "}
        <a class="quiet" href={orgs.purdue}>
            Purdue
        </a>{" "}
        (28'), originally from Joinville, in the south of Brazil.
    </p>
    <p>
        I’ve interned twice as a software engineer at{" "}
        <a class="quiet" href={orgs.btg}>
            BTG Pactual
        </a>
        , and I ran technology for the{" "}
        <a class="quiet" href={orgs.brasa}>
            largest Brazilian student association
        </a>{" "}
        of <mark>20,000+ members</mark>. This fall I started research at
        Purdue’s{" "}
        <a class="quiet" href={orgs.autoic}>
            AutoIC Lab
        </a>{" "}
        and work as a TA in the intro CS course.
    </p>

    <h2>currently</h2>
    <ul class="todo">
        <li class="done">
            <Scribble shape="check" class="tick" />
            research at AutoIC: AI and NLP for construction
        </li>
        <li class="done">
            <Scribble shape="check" class="tick" />
            weekly CS 18000 lab sections, 25 students per section
        </li>
        <li>searching for my next build project</li>
    </ul>

    <h2>find me</h2>
    <LinkIcons />

    <Fragment slot="right">
        <div class="snapshots" data-free>
            <div class="me">
                <Polaroid caption="me" src="/photos/me.jpg" tilt={-3} />
                <div class="me-label">
                    <p class="me-note hand">that’s me</p>
                    <Scribble shape="arrowDown" class="me-arrow" />
                </div>
            </div>
            <div class="second">
                <Polaroid caption="Purdue" src="/photos/purdue.jpg" tilt={5} />
            </div>
        </div>

        <h2>in this notebook</h2>
        <ol class="contents">
            {contents.map((c) => (
                <li>
                    <a href={c.href}>
                        <span class="c-title">{c.label}</span>
                        <span class="c-what">{c.what}</span>
                        <span class="c-dots" aria-hidden="true" />
                        <span class="c-page">p. {c.page}</span>
                    </a>
                    {c.note && <span class="c-note hand">↑ {c.note}</span>}
                </li>
            ))}
        </ol>
    </Fragment>
</Notebook>

<style>
    .todo {
        list-style: none;
        padding: 0;
    }
    .todo li {
        position: relative;
        padding-left: 2rem;
    }
    .todo li::before {
        content: "";
        position: absolute;
        left: 0.1rem;
        top: calc(var(--line) / 2 - 0.55rem);
        width: 1rem;
        height: 1rem;
        border: 1.5px solid var(--ink-soft);
        border-radius: 2px;
    }
    :global(.tick) {
        position: absolute;
        left: 0;
        top: calc(var(--line) / 2 - 0.85rem);
        width: 1.3rem;
        height: 1.3rem;
    }

    .snapshots {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: start;
        margin-bottom: calc(var(--line) * -1);
    }
    .me {
        display: grid;
        justify-items: center;
        align-content: start;
    }
    .second {
        display: grid;
        justify-items: center;
        margin: calc(var(--line) * 5) 0 0 -3rem;
    }
    /* above the photo even after dragging (draggable.ts z-index starts at 10) */
    .me-label {
        position: relative;
        z-index: 1000;
        display: flex;
        align-items: end;
        margin-top: -1.3rem;
        translate: -4.6rem 0.8rem;
    }
    .me-note {
        font-size: 1.4rem;
        rotate: -6deg;
    }
    :global(.me-arrow) {
        width: 3rem;
        height: 4rem;
        rotate: -90deg; /* tail by the note, tip up at the photo */
        margin-left: 0.8rem;
    }

    .contents {
        list-style: none;
        padding: 0;
    }
    /* fixed height: mixed font sizes */
    .contents a {
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
        height: var(--line);
        text-decoration: none;
    }
    .c-title {
        font-style: italic;
        font-size: 1.9rem;
        min-width: 4.6rem;
    }
    .c-what {
        color: var(--ink-soft);
        font-size: 1.4rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .c-dots {
        flex: 1;
        min-width: 1rem;
        border-bottom: 2px dotted var(--ink-soft);
        translate: 0 -0.35rem;
        opacity: 0.6;
    }
    .c-page {
        font-family: var(--font-mono);
        font-size: 1.1rem;
        color: var(--ink-soft);
        white-space: nowrap;
    }
    .contents a:hover .c-title {
        color: var(--red);
    }
    .contents a:hover .c-dots {
        border-color: var(--red);
    }
    .c-note {
        display: block;
        margin-left: 5.2rem;
        font-size: 1.45rem;
        color: var(--red);
        rotate: -1.5deg;
    }

    @media (max-width: 40rem) {
        .snapshots {
            grid-template-columns: 1fr;
            margin-bottom: 0;
        }
        .me {
            justify-items: start;
        }
        .me-label {
            translate: 0.25rem 0.5rem;
        }
        .second {
            justify-items: end;
            margin: calc(var(--line) * -0.5) 0 0 0;
        }
        .c-what {
            display: none;
        }
        .c-note {
            margin-left: 0;
        }
    }
</style>
