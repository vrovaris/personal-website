---
// Deliberately minimal: head, tokens, theme attribute. The two-track grid and
// the boundary rule belong to P1-03, which extends this rather than replaces it.
interface Props {
  title: string;
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;
import '../styles/tokens.css';
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href="/fonts/newsreader.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // D5: one theme ships, but the wiring lands in Phase 1 so dark mode is a
      // token swap later. With no [data-theme="dark"] rules yet this is inert.
      (() => {
        const dark = window.matchMedia('(prefers-color-scheme: dark)');
        const apply = () => {
          document.documentElement.dataset.theme = dark.matches ? 'dark' : 'light';
        };
        apply();
        dark.addEventListener('change', apply);
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
