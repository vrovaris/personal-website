---
interface Props {
  caption: string;
  want?: string; // placeholder text
  src?: string;
  tilt?: number;
}

const { caption, want, src, tilt = -3 } = Astro.props;
---

<figure class="polaroid" data-drag style={`--tilt: ${tilt}deg`}>
  <span class="tape" aria-hidden="true"></span>
  {
    src ? (
      <img src={src} alt={caption} width="800" height="800" loading="lazy" draggable="false" />
    ) : (
      <div class="empty" role="img" aria-label={`Photo placeholder: ${want}`}>
        <span>photo goes here</span>
        <small>{want}</small>
      </div>
    )
  }
  <figcaption>{caption}</figcaption>
</figure>

<script>
  import { draggable } from '../../scripts/draggable';
  document.addEventListener('astro:page-load', draggable);
</script>

<style>
  .polaroid {
    position: relative;
    width: 16rem;
    padding: 0.65rem 0.65rem 0;
    background: #fff;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.12), 0 10px 18px -10px rgb(60 45 20 / 0.45);
    rotate: var(--tilt);
    transition: rotate 300ms var(--ease), scale 300ms var(--ease), box-shadow 300ms var(--ease);
  }
  .polaroid:hover { rotate: calc(var(--tilt) * 0.3); }
  .polaroid:global(.is-held) {
    scale: 1.05;
    rotate: 0deg;
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.1), 0 24px 36px -14px rgb(60 45 20 / 0.5);
  }
  .tape {
    position: absolute;
    top: -0.7rem;
    left: 50%;
    width: 4.5rem;
    height: 1.4rem;
    translate: -50% 0;
    rotate: 4deg;
    background: rgb(240 230 200 / 0.75);
    box-shadow: 0 1px 1px rgb(0 0 0 / 0.08);
  }
  img, .empty {
    width: 100%;
    height: auto; /* the img's width/height attributes only reserve space while it loads */
    aspect-ratio: 1;
    object-fit: cover;
  }
  .empty {
    display: grid;
    place-content: center;
    gap: 0.25rem;
    padding: 1rem;
    text-align: center;
    background: repeating-linear-gradient(-45deg, #f3eee4 0 8px, #ebe4d6 8px 16px);
    color: var(--ink-soft);
  }
  .empty span { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .empty small { font-family: var(--font-hand); font-size: 1rem; line-height: 1.3; color: var(--pen); }
  figcaption {
    font-family: var(--font-hand);
    font-size: 1.15rem;
    text-align: center;
    line-height: 2.8rem;
  }
</style>
