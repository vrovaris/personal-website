---
// paths draw in when revealed; size comes from the parent
const shapes = {
  arrowDown: { box: '0 0 60 80', d: ['M12 6 C 4 30, 14 56, 42 70', 'M27 74 L 43 71 L 39 56'] },
  star: { box: '0 0 60 60', d: ['M30 5 L 37 23 L 56 24 L 41 36 L 47 55 L 30 44 L 13 55 L 19 36 L 4 24 L 23 23 Z'] },
  check: { box: '0 0 40 40', d: ['M6 22 L 16 32 L 35 6'] },
} as const;

interface Props {
  shape: keyof typeof shapes;
  class?: string;
  color?: string;
}

const { shape, class: className, color = 'var(--pen)' } = Astro.props;
const { box, d } = shapes[shape];
---

<svg class:list={['scribble', className]} viewBox={box} fill="none" aria-hidden="true" data-reveal style={`--c: ${color}`}>
  {d.map((path, i) => <path d={path} pathLength="1" style={`--i: ${i}`} />)}
</svg>

<style>
  .scribble {
    overflow: visible;
    pointer-events: none;
  }
  path {
    stroke: var(--c);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 800ms var(--ease) calc(200ms + var(--i) * 450ms);
  }
  .is-seen path { stroke-dashoffset: 0; }
</style>
