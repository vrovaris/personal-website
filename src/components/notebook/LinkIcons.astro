---
// résumé falls back to /work without public/resume.pdf
import { existsSync } from "node:fs";
import { profile } from "../../data/profile";

const { links } = profile;
const resume = existsSync("public/resume.pdf") ? "/resume.pdf" : "/work/";

const items = [
    {
        label: "email",
        href: `mailto:${links.email}`,
        paths: ["M7 13 L 41 12 L 42 36 L 6 37 Z", "M7 14 L 24 27 L 41 13"],
    },
    {
        label: "linkedin",
        href: links.linkedin,
        paths: [
            "M10 8 L 38 7.5 Q 41 7.5 41 10.5 L 41.5 38 Q 41.5 40.5 38.5 40.5 L 10 41 Q 7 41 7 38 L 7 11 Q 7 8 10 8",
            "M15 16 l 0.1 0.1 M 15 21 L 15 33",
            "M22 33 L 22 21 M 22 25.5 C 24 20, 32 20, 32 26 L 32 33",
        ],
    },
    {
        label: "github",
        href: links.github,
        paths: [
            "M13 37 C 9 30, 9 22, 13 17 L 12 7 L 20 12 C 22.5 11, 25.5 11, 28 12 L 36 7 L 35 17 C 39 22, 39 30, 35 37 C 29 41, 19 41, 13 37",
            "M15 38.5 C 8 41, 3.5 37, 5 31.5 C 5.8 28.5, 4.5 27, 3 27.5",
            "M19 24 q 1.5 -2 3 0 M 26 24 q 1.5 -2 3 0",
        ],
    },
    {
        label: "résumé",
        href: resume,
        paths: [
            "M12 6 L 30 6 L 38 14 L 38 42 L 12 42 Z",
            "M30 6 L 30 14 L 38 14",
            "M17 21 L 33 21 M 17 27 L 33 27 M 17 33 L 28 33",
        ],
    },
];
---

<ul class="links" data-free data-reveal>
    {items.map((it, i) => (
        <li style={`--i: ${i}`}>
            <a href={it.href}>
                <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                    {it.paths.map((d) => (
                        <path d={d} pathLength="1" />
                    ))}
                </svg>
                <span class="hand">{it.label}</span>
            </a>
        </li>
    ))}
</ul>

<style>
    /* 3 lines tall, pulled up into the blank line under the heading */
    .links {
        list-style: none;
        padding: 0;
        margin-top: calc(var(--line) * -1);
        display: flex;
        flex-wrap: wrap;
        gap: 0 3rem;
    }
    li {
        height: calc(var(--line) * 3);
    }
    a {
        display: grid;
        justify-items: center;
        align-content: center;
        height: 100%;
        color: var(--ink);
        text-decoration: none;
    }
    svg {
        width: 4.8rem;
        height: 4.8rem;
        transition: transform 250ms var(--ease);
    }
    path {
        stroke: currentColor;
        stroke-width: 2.2;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        transition: stroke-dashoffset 900ms var(--ease)
            calc(300ms + var(--i) * 200ms);
    }
    .links:global(.is-seen) path {
        stroke-dashoffset: 0;
    }
    span {
        font-size: 1.45rem;
        line-height: 1.6rem;
    }
    a:hover {
        color: var(--red);
    }
    a:hover span {
        color: var(--red);
    }
    a:hover svg {
        transform: rotate(-6deg) scale(1.08);
    }
    @media (max-width: 40rem) {
        .links {
            gap: 0 1.4rem;
        }
        li {
            height: calc(var(--line) * 3);
        }
        svg {
            width: 3.2rem;
            height: 3.2rem;
        }
        span {
            font-size: 1.1rem;
        }
    }
</style>
